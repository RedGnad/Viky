{
  "name": "viky",
  "version": "0.1.0",
  "private": true,
  "description": "The money is already in their name. A conditional gift on Monad, released as verified progress accrues, refunded for every missed day.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:policy && pnpm test:solidity",
    "test:policy": "tsx --test test/*.test.ts",
    "test:solidity": "forge test --network monad -vvv",
    "build:contracts": "forge build && tsx scripts/export-gift-abi.ts",
    "check:contract-sizes": "tsx scripts/check-contract-sizes.ts",
    "deploy:gift-escrow": "tsx scripts/deploy-gift-escrow.ts",
    "check:gift-escrow": "tsx scripts/check-gift-escrow.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "keeper": "tsx scripts/keeper.ts",
    "spike:preflight": "tsx scripts/spike/preflight.ts",
    "proof:capture": "tsx scripts/capture-duolingo-proof.ts",
    "proof:transform": "tsx scripts/transform-duolingo-proof.ts",
    "register:goal": "tsx scripts/register-goal.ts"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@neondatabase/serverless": "1.1.0",
    "@reclaimprotocol/js-sdk": "5.8.2",
    "@reclaimprotocol/zk-fetch": "^1.1.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "dotenv": "17.4.2",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "@reclaimprotocol/solidity-sdk": "github:reclaimprotocol/reclaim-solidity-sdk#3326a4e4b7d747b3f06d027a7c40ec8612bd0b5a",
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "serwist": "9.5.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
