{
  "name": "viky",
  "version": "0.1.0",
  "private": true,
  "description": "The money is already in their name. A conditional gift on Monad, released as verified progress accrues, refunded for every missed day.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:policy && pnpm test:solidity",
    "test:policy": "tsx --test test/*.test.ts",
    "test:solidity": "forge test --network monad -vvv",
    "build:contracts": "forge build && tsx scripts/export-gift-abi.ts",
    "check:contract-sizes": "tsx scripts/check-contract-sizes.ts",
    "deploy:gift-escrow": "tsx scripts/deploy-gift-escrow.ts",
    "deploy:exit-router": "tsx scripts/deploy-exit-router.ts",
    "deploy:usdc-router": "tsx scripts/deploy-exit-router.ts --takes=usdc",
