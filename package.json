    "review:capture": "tsx scripts/review-capture.ts",
    "review:capture-funder": "tsx scripts/audit-funder-walk.ts",
    "looks:capture": "tsx scripts/capture-looks.ts",
    "capture:appearance": "tsx scripts/capture-appearance.ts",
    "make:characters": "tsx scripts/make-characters.ts",
    "make:icon": "tsx scripts/make-icon.ts",
    "check:morning-push": "tsx scripts/check-morning-push.ts",
    "register:milestone-goals": "tsx scripts/register-milestone-goals.ts",
