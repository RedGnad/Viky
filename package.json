    "rehearse:v3": "tsx scripts/rehearse-v3-fork.ts",
    "check:gift-escrow": "tsx scripts/check-gift-escrow.ts",
    "check:signer": "tsx scripts/check-signer.ts",
    "check:sources": "tsx scripts/check-sources.ts",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "backfill:days": "tsx scripts/backfill-days.ts",
    "keeper": "tsx scripts/keeper.ts",
    "proof:capture": "tsx scripts/capture-duolingo-proof.ts",
    "proof:transform": "tsx scripts/transform-duolingo-proof.ts",
    "proof:inspect": "tsx scripts/inspect-proof.ts",
    "register:goal": "tsx scripts/register-goal.ts",
    "count:gift": "tsx scripts/count-gift.ts",
    "verify:day": "tsx scripts/verify-day.ts",
    "verify:consent": "tsx scripts/verify-consent.ts",
    "zkfetch:worker": "tsx scripts/zkfetch-worker.ts",
    "check:words": "tsx scripts/check-consumer-words.ts",
    "check:universities": "tsx scripts/check-universities.ts",
    "test:browser": "playwright test",
    "pilot:report": "tsx scripts/pilot-report.ts",
    "relayer:fees": "tsx scripts/relayer-fees.ts",
