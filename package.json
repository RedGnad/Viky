    "review:capture-connected": "tsx scripts/capture-connected.ts",
    "measure:words": "tsx scripts/measure-words.ts",
    "measure:contrast": "tsx scripts/measure-contrast.ts",
    "capture:refund": "tsx scripts/capture-refund.ts",
