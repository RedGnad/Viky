    "deploy:v2": "tsx scripts/deploy-v2.ts",
    "check:v2-handover": "tsx scripts/check-v2-handover.ts",
    "deploy:v3": "tsx scripts/deploy-v3.ts",
    "check:v3-handover": "tsx scripts/check-v3-handover.ts",
