{
  "name": "viky",
  "version": "0.1.0",
  "private": true,
  "description": "The money is already in their name. A conditional gift on Monad, released as verified progress accrues, refunded for every missed day.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core", "esbuild", "unrs-resolver"]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:policy && pnpm test:solidity",
    "test:policy": "tsx --test test/*.test.ts",
    "test:solidity": "forge test --network monad -vvv"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.3",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "serwist": "9.5.12",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
