  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@neondatabase/serverless": "1.1.0",
    "@reclaimprotocol/js-sdk": "5.8.2",
    "@reclaimprotocol/zk-fetch": "^1.1.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
