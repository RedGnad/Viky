{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/settle",
      "schedule": "0 7 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false,
      "**": false
    }
  }
}
