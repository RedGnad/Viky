# Every variable Viky reads, with no value. Copy this file to .env.local, which is never committed.
# Nothing here is needed for: pnpm verify:day, pnpm relayer:fees, pnpm test:policy.

# --- To start: accounts and screens, nothing moves money ---------------------------------------------------------
# HMAC key (32 characters or more) of the account challenge and of the twelve-hour session cookie.
SESSION_SIGNING_SECRET=
# Neon Postgres connection string: sessions, gift records, agreements.
DATABASE_URL=
# Monad mainnet RPC read by the browser. https://rpc.monad.xyz when empty.
NEXT_PUBLIC_MONAD_RPC_URL=
# Origin written in a gift's link. The request's own origin when empty.
NEXT_PUBLIC_APP_URL=
# Contact shown on /legal, and where a person is told to write when a monthly limit is reached. The page says one is
# coming until it is set, and the sentence that would name it is left out.
NEXT_PUBLIC_CONTACT_EMAIL=

# --- For the money: gifts made, opened and settled on mainnet ------------------------------------------------------
# RPC used by the relayer and by Foundry scripts.
MONAD_RPC_URL=
# Key of the relayer, which submits and pays every relayed step. It refuses to send below 12 MON.
RELAYER_PRIVATE_KEY=
# Key of the evidence signer, whose EIP-712 attestations the contracts accept.
EVIDENCE_SIGNER_PRIVATE_KEY=
# base64 key of the pseudonymous identity bound to a gift.
IDENTITY_HMAC_KEY=
# The gift contracts. Verification fails closed without them.
GIFT_ESCROW_ADDRESS=
NEXT_PUBLIC_GIFT_ESCROW_ADDRESS=
NEXT_PUBLIC_EARLIER_GIFT_ESCROW_ADDRESS=
MILESTONE_GIFT_ADDRESS=
NEXT_PUBLIC_MILESTONE_GIFT_ADDRESS=
# The second version of the two gift contracts and the public record of agreements (src/v2.ts). Empty, the second
# version is off: no gift is made on it and nothing changes. Set, new gifts are made on it, and the contracts above
# keep serving the gifts they hold.
NEXT_PUBLIC_GIFT_ESCROW_V2_ADDRESS=
NEXT_PUBLIC_MILESTONE_GIFT_V2_ADDRESS=
NEXT_PUBLIC_CONSENT_ANCHOR_ADDRESS=
# The third daily contract, where a day is paid by a reading taken that same day (src/v2.ts). Empty, it is off. Set
# only once the three above are: new daily gifts are then made on it, and the second version keeps the gifts it holds.
NEXT_PUBLIC_GIFT_ESCROW_V3_ADDRESS=
# The way out: the router and the exchange it is allowed to call.
EXIT_ROUTER_ADDRESS=
EXIT_EXCHANGE_ADDRESS=
# Bearer token Vercel sends to the passes and to the watch (/api/cron/daily, /api/cron/recount, /api/cron/settle,
# /api/cron/watch).
CRON_SECRET=
# The most relayed actions Viky pays for, per account and per connection (20 an hour and 100 a day when empty), for
# everybody together in a day (500 when empty), and the smallest relayed send or withdrawal, in cents (100 when empty).
RELAY_PER_HOUR=
RELAY_PER_DAY=
RELAY_PER_DAY_ALL=
RELAY_MINIMUM_CENTS=
TOP_UPS_PER_MINUTE=
TOP_UPS_PER_GIFT=
# Paying by card. Each partner is offered only when its own setting is there.
NEXT_PUBLIC_RAMP_HOST_API_KEY=
NEXT_PUBLIC_SWAPPER_INTEGRATOR_ID=
NEXT_PUBLIC_RAMPNOW_WAY_IN=
NEXT_PUBLIC_USDC_ROUTER_ADDRESS=
# Rampnow inside Viky, in a frame: "on". Its public key (pk_...) from the Partner Dashboard is optional: the server
# adds it to the frame's address when it is set, and without one the frame takes Rampnow's public locked page as it is.
# With the key, the server also asks Rampnow its quote in the currency a person reads Viky in (src/rampnow-quote.ts).
NEXT_PUBLIC_RAMPNOW_FRAME=
RAMPNOW_API_KEY=
# The way out to phone credit and gift cards.
BITREFILL_API_ID=
BITREFILL_API_KEY=
BITREFILL_API_SECRET=
BASE_RPC_URL=
TREASURY_ADDRESS=
TREASURY_PRIVATE_KEY=
# The credit a judge's code gives, while it is open.
JUDGE_CODE=
JUDGE_CREDIT_AUSD=
JUDGE_CREDIT_CAP_AUSD=

# --- For the readings: a gift's condition is read and proved -------------------------------------------------------
# Reclaim application: a proof shown from the person's own account. The secret also verifies the TEE attestation.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
# portal (when empty) or app: the Reclaim delivery channel. Production stays on portal: in app mode Reclaim's agent
# did nothing for a university's portal (7 Oct 2026), and a university is read on the portal whatever this says.
RECLAIM_VERIFICATION_MODE=
# Reclaim "Public Data (zkFetch)" application: the readings Viky makes itself.
RECLAIM_ZKFETCH_APP_ID=
RECLAIM_ZKFETCH_APP_SECRET=
# Reclaim's allowance for a cycle, when it has granted more than the free tier's 100 attested fetches and 25
# verifications (src/attested-calls.ts). Empty, the free tier's. Past it Viky sends nothing more and says so.
RECLAIM_FETCH_ALLOWANCE=
RECLAIM_VERIFICATION_ALLOWANCE=
# The breaker: the most proofs a UTC day may take, for one gift and for all (src/attested-calls.ts). Empty, 4 and 25.
# Zero stops every paid reading. Past a ceiling nothing is sent to Reclaim until the next UTC day.
RECLAIM_DAILY_PER_GIFT=
RECLAIM_DAILY_ALL=
# On a developer's machine only, never on a deployment: 1 refuses every real reading and every proof opened at
# Reclaim before anything leaves, so a local run cannot spend the month's allowance (src/attested-calls.ts).
VIKY_NO_REAL_READING=
# The attested-fetch worker (pnpm zkfetch:worker), needed on Vercel, whose functions cannot load zk-fetch.
ZKFETCH_WORKER_URL=
ZKFETCH_WORKER_SECRET=
# Viky's own pin of the attestors a reading may be signed by, comma separated.
RECLAIM_ATTESTOR_ADDRESSES=
# Behind the switch, not set in production: local verifies a reading offline, and the digests pin the attestor's TEE.
PROOF_VERIFIER=
RECLAIM_ATTESTOR_IMAGE_DIGESTS=
# Optional cross-check against the pinned Duolingo provider.
DUOLINGO_PROVIDER_ID=
DUOLINGO_PROVIDER_VERSION=
# Sources a person connects with their own key, and the key their sealed tokens are kept under.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
CONNECT_TOKEN_KEY=

# --- Messages -------------------------------------------------------------------------------------------------------
# VAPID web push: npx web-push generate-vapid-keys
WEB_PUSH_EMAIL=
WEB_PUSH_PRIVATE_KEY=
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
# The operator's alerts by e-mail (a first proof to review, a provider to build).
RESEND_API_KEY=
ALERT_FROM=
ALERT_TO=

# 1 leaves the two passkey ceremonies to Mera's own client (src/client/consent-key.ts). Empty, Viky's client asks the
# consent key in the same ceremony as the account's.
NEXT_PUBLIC_MERA_OWN_CLIENT=
# The GraphQL endpoint of Viky's index (the Viky-index repository, Envio), read by the judges page alone. Empty, the
# page says the index is not set. Nothing that moves money reads it.
ENVIO_GRAPHQL_URL=

# --- Operator -------------------------------------------------------------------------------------------------------
# Dev pages (/dev/*) and dev routes answer only with VIKY_DEV_PAGES=1 to an account of the operator list.
VIKY_DEV_PAGES=
VIKY_OPERATOR_ACCOUNTS=
# The design gallery at /dev/looks.
VIKY_DESIGN_GALLERY=
# Accounts kept apart in pnpm pilot:report, comma separated.
PILOT_FOUNDER_ACCOUNTS=
# A script may write to the production database only with this set to 1.
VIKY_ALLOW_PRODUCTION_DATABASE=
# Inputs of pnpm deploy:gift-escrow and pnpm check:gift-escrow. FIRST_GIFT_ID continues the gift numbering.
DEPLOYER_PRIVATE_KEY=
EVIDENCE_SIGNER_ADDRESS=
OWNER_ADDRESS=
FIRST_GIFT_ID=
